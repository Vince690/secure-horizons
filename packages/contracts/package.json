    "@types/chai": "^4.3.0",
    "@types/mocha": "^10.0.0",
    "@types/node": "^20.0.0",
    "chai": "^4.3.0",
    "dotenv": "^16.4.5",
    "dotenv-cli": "^8.0.0",
    "hardhat": "^2.29.0",
