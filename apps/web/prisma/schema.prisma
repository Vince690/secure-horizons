// PayGuard data model. Lists and nested objects are stored as JSON strings
// (SQLite has no JSON column type in Prisma 6); the mapping lives in src/lib/mappers.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Account {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  companyName  String
  createdAt    DateTime @default(now())

  apiKeys      ApiKey[]
  policy       Policy?
  recipients   Recipient[]
  decisions    Decision[]
  auditEntries AuditEntry[]
  killSwitch   KillSwitch?
}

model ApiKey {
  id        String    @id @default(cuid())
  accountId String
  account   Account   @relation(fields: [accountId], references: [id])
  /// sha256 of the full key; the clear key is shown once and never stored
  keyHash   String    @unique
  /// first 12 chars (e.g. "pg_test_ab12") so the dashboard can identify the key
  prefix    String
  label     String
  createdAt DateTime  @default(now())
  revokedAt DateTime?
}

model Policy {
  accountId                String  @id
  account                  Account @relation(fields: [accountId], references: [id])
  maxPerTx                 String
  maxDaily                 String
  minBalance               String
  autoApproveScore         Int
  holdScore                Int
  requireConfirmationAbove String
  confirmNewRecipients     Boolean @default(true)
  /// Virtual-card rail mandate, in EUR
  cardMaxPerTx                 String @default("100")
  cardMaxDaily                 String @default("300")
  cardMinBalance               String @default("20")
  cardRequireConfirmationAbove String @default("80")
  /// JSON string[] of lowercase addresses
  trustedRecipients        String  @default("[]")
  blockedRecipients        String  @default("[]")
  trustedDomains           String  @default("[]")
  updatedAt                DateTime @updatedAt
}

model Recipient {
  id          String   @id @default(cuid())
  accountId   String
  account     Account  @relation(fields: [accountId], references: [id])
  address     String
  name        String?
  domain      String?
  trusted     Boolean  @default(false)
  firstSeenAt DateTime @default(now())

  @@unique([accountId, address])
}

model Decision {
  id              String    @id
  accountId       String
  account         Account   @relation(fields: [accountId], references: [id])
  agentId         String
  requestId       String
  amount          String
  currency        String    @default("AVAX")
  rail            String    @default("avalanche")
  recipientAddress String
  recipientName   String?
  recipientDomain String?
  purpose         String
  score           Int
  verdict         String
  status          String
  /// JSON Reason[]
  reasonsJson     String
  /// JSON ComplianceSummary
  complianceJson  String
  explanation     String
  decisionHash    String
  /// JSON ChainReference | null
  paymentTxJson   String?
  ledgerTxJson    String?
  /// JSON of the request context (page excerpt, conversation) for the detail page
  contextJson     String?
  createdAt       DateTime  @default(now())
  resolvedAt      DateTime?
  resolvedBy      String?

  @@unique([accountId, requestId])
  @@index([accountId, createdAt])
}

model AuditEntry {
  id          String   @id @default(cuid())
  accountId   String
  account     Account  @relation(fields: [accountId], references: [id])
  seq         Int
  event       String
  payloadJson String
  prevHash    String
  hash        String
  createdAt   DateTime @default(now())

  @@unique([accountId, seq])
}

model KillSwitch {
  accountId    String    @id
  account      Account   @relation(fields: [accountId], references: [id])
  active       Boolean   @default(false)
  reason       String?
  activatedAt  DateTime?
  /// JSON ChainReference | null
  onchainTxJson String?
  updatedAt    DateTime  @updatedAt
}

/// Step 7: LLM explanations cached by decision hash so the demo never waits twice.
model ExplanationCache {
  decisionHash String   @id
  text         String
  createdAt    DateTime @default(now())
}

/// Single-use virtual card issued by the connected bank (sandbox issuer for the hackathon).
/// The full PAN is kept by the issuer only; we store what the dashboard may show.
model VirtualCard {
  id             String   @id
  accountId      String
  /// The decision this card was issued for (no FK: the card is issued by the rail
  /// before the decision row is written, and human approvals use "<id>:approved").
  decisionId     String   @unique
  provider       String   @default("sandbox-bank")
  brand          String   @default("VISA")
  last4          String
  expiry         String
  limitAmount    String
  currency       String   @default("EUR")
  merchantLock   String?
  status         String   @default("active")
  issuedAt       DateTime @default(now())
  expiresAt      DateTime
  /// JSON of the last authorization attempt (sandbox)
  lastAuthJson   String?

  @@index([accountId, status])
}

/// Sandbox bank account behind the virtual-card rail (one per PayGuard account).
model BankAccount {
  accountId   String   @id
  provider    String   @default("sandbox-bank")
  label       String   @default("Compte courant (bac à sable)")
  currency    String   @default("EUR")
  balance     String   @default("500.00")
  frozen      Boolean  @default(false)
  updatedAt   DateTime @updatedAt
}
