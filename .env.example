# ---- PayGuard — copy to .env and fill in. NEVER commit .env. ----

# LLM used for French explanations of each verdict, the semantic second opinion on pages, and the fallback demo agent.
# Leave empty to run without LLM (template explanations, pattern rules only).
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_TIMEOUT_MS=4000

# Avalanche Fuji (C-Chain, chainId 43113). Testnet only.
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
FUJI_CHAIN_ID=43113
# Dedicated HACKATHON wallet that holds the agent's test funds and owns the contract.
# Never a wallet with real funds. Never a personal key.
GUARDIAN_PRIVATE_KEY=
# Filled after `npm run deploy:fuji -w packages/contracts`. Also recorded in README.md and packages/contracts/deployments/fuji.json.
PAYGUARD_CONTRACT_ADDRESS=
SNOWTRACE_BASE_URL=https://testnet.snowtrace.io

# Web app (dashboard + API)
DATABASE_URL="file:./dev.db"
SESSION_SECRET=change-me-32-chars-minimum-random-string
NEXT_PUBLIC_APP_URL=http://localhost:3000

# MCP server -> API
PAYGUARD_API_URL=http://localhost:3000
PAYGUARD_API_KEY=

# Demo merchants (static pages)
MERCHANT_LEGIT_URL=http://localhost:4001
MERCHANT_TRAP_URL=http://localhost:4002
MERCHANT_ALT_URL=http://localhost:4003

# Chain mode: "mock" (in-memory, default while PAYGUARD_CONTRACT_ADDRESS is empty) or "fuji"
CHAIN_MODE=mock
MOCK_CHAIN_BALANCE=2
# Demo merchants (seeded as trusted / used by scripts)
MERCHANT_LEGIT_ADDRESS=0x1111111111111111111111111111111111111111
MERCHANT_LEGIT_DOMAIN=nordsound.shop
MERCHANT_TRAP_ADDRESS=0x2222222222222222222222222222222222222222
